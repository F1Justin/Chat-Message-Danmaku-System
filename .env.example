# 数据库连接信息
# 同机部署 PostgreSQL 时保持 127.0.0.1，不要把数据库端口暴露到公网。
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name

# 应用设置
# 推荐让 FastAPI 只监听本机，由 Caddy/Nginx 反代公网 HTTPS。
APP_HOST=127.0.0.1
APP_PORT=8000
ROOT_PATH=
LOG_LEVEL=INFO

# 来源限制
# 反代同机部署保持默认即可；如果要让应用直接监听公网，改成 ["*"] 并务必配置鉴权。
ALLOWED_HOSTS=["127.0.0.1","::1","localhost"]

# 公网鉴权
# /control、/api/* 和 WebSocket 控制命令需要 ADMIN_TOKEN。
# REQUIRE_VIEW_TOKEN=true 时，弹幕页 / 和 WebSocket 观看也需要 VIEW_TOKEN 或 ADMIN_TOKEN。
ADMIN_TOKEN=replace_with_a_long_random_admin_token
VIEW_TOKEN=replace_with_a_long_random_view_token
REQUIRE_VIEW_TOKEN=false
AUTH_COOKIE_NAME=danmaku_auth
